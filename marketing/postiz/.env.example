# Copy to .env on the Postiz host (/opt/postiz/.env). NEVER commit the real .env.
# JWT_SECRET: generate a fresh one per install -> `openssl rand -hex 48`
JWT_SECRET=replace-with-openssl-rand-hex-48

# Reused from the old install (social/.env). Do NOT regenerate on X — a lost secret can't be re-shown.
X_API_KEY=your-x-consumer-key
X_API_SECRET=your-x-consumer-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Keep false until your admin account exists, then set true and `docker compose up -d`
DISABLE_REGISTRATION=false
