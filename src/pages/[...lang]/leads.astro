---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import Subtitle from "@/layouts/components/widgets/Subtitle.astro";
import ButtonLink from "@/layouts/components/buttons/ButtonLink.astro";

export function getStaticPaths() {
  return generatePaths();
}

const APP = "https://app.sendemall.com/register";

// Premium card treatment (reads on both themes): elevation + icon chip + hover lift/glow.
const CARD =
  "group border-border-light bg-theme-dark hover:border-primary/40 relative overflow-hidden rounded-2xl border p-6 shadow-[0_10px_40px_-18px_rgba(125,60,194,0.22)] transition duration-300 hover:-translate-y-1";

const sources = [
  {
    k: "Search our 66M-contact lake",
    v: "A verified, continuously re-checked B2B database — search by title, industry, size, tech, and geography with no account connected.",
    icon: '<path d="M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2z"/><path d="M4 6v6c0 1.1 3.6 2 8 2s8-.9 8-2V6"/><path d="M4 12v6c0 1.1 3.6 2 8 2s8-.9 8-2v-6"/>',
  },
  {
    k: "Bring your own Apollo / Sales Nav",
    v: "Connect the seat you already pay for — your data, your limits, on a dedicated IP in your region so your account stays stable and secure.",
    icon: '<path d="M16 3h5v5"/><path d="M21 3 9 15"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/>',
  },
  {
    k: "Describe your ICP in plain English",
    v: "Type who you want in one sentence. See a live per-filter match-rate and a leakage report — before you spend a single credit.",
    icon: '<path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>',
  },
];

const signals = [
  { k: "Hiring", v: "Roles that signal a budget and a pain" },
  { k: "Funding", v: "Fresh capital, ready to spend" },
  { k: "Ad spend", v: "Actively investing in growth" },
  { k: "Tech stack", v: "7,500+ technologies detected" },
];
---

<Base
  metaTitle="Verified B2B Leads, ICP Search & Buying Signals | SendEmAll"
  disableTagline={true}
  metaDescription="Find verified B2B buyers from a 66M-contact lake, your own Apollo/Sales Navigator account, or a plain-English ICP. Filter by buying signals, verify every email, and pay only for valid, deliverable addresses."
>
  <!-- Hero -->
  <section class="py-20 lg:py-28">
    <div class="container text-center">
      <Subtitle content="Leads" />
      <h1 class="font-secondary has-italic-text mx-auto max-w-4xl text-4xl md:text-6xl/tight" data-aos="fade-up-sm">
        The right buyers — verified, <strong class="font-tertiary italic">or you don't pay.</strong>
      </h1>
      <p class="text-text-default/70 mx-auto mt-6 max-w-2xl text-lg" data-aos="fade-up-sm" data-aos-delay="100">
        Most "lead" tools charge you for guessed, unverified addresses that bounce and quietly burn your domain.
        SendEmAll finds the right buyers, verifies every email before it reaches you, and only bills you for the
        ones that are real.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4" data-aos="fade-up-sm" data-aos-delay="200">
        <ButtonLink class="btn-md btn-primary" content={{ enable: true, label: "Start finding buyers", url: APP }} />
        <ButtonLink class="btn-md btn-outline-primary" content={{ enable: true, label: "See pricing", url: "/pricing" }} />
      </div>
      <div class="mt-14" data-aos="fade-up-sm" data-aos-delay="300">
        <img
          src="/images/product/leads-table.svg"
          width="720"
          height="460"
          loading="eager"
          fetchpriority="high"
          alt="SendEmAll lead search — each email marked valid, accepts-all, or unverified before delivery"
          class="border-border-light mx-auto w-full max-w-4xl rounded-2xl border"
        />
      </div>
    </div>
  </section>

  <!-- Three ways to build a list -->
  <section class="section-gradient py-16 md:py-24">
    <div class="container">
      <div class="mx-auto mb-14 max-w-2xl text-center" data-aos="fade-up-sm">
        <Subtitle content="Where your leads come from" />
        <h2 class="font-secondary has-italic-text text-3xl md:text-4xl/tight">
          Three ways in. <strong class="font-tertiary italic">All verified.</strong>
        </h2>
        <p class="text-text-default/70 mt-5 text-lg">
          Use our data, your data, or just describe who you want — every path ends in verified, deliverable
          contacts, never a raw scrape you have to clean.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          sources.map((s, i) => (
            <div class={CARD} data-aos="fade-up-sm" data-aos-delay={i * 100}>
              <span class="bg-primary/10 text-primary mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </span>
              <h3 class="text-heading text-lg font-semibold">{s.k}</h3>
              <p class="text-text-default/70 mt-2 text-sm">{s.v}</p>
              <span class="bg-primary/10 pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full opacity-0 blur-2xl transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Buying signals -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-aos="fade-up-sm">
          <Subtitle content="Buying signals" />
          <h2 class="font-secondary has-italic-text text-3xl md:text-4xl/tight">
            Reach the ones <strong class="font-tertiary italic">who are ready.</strong>
          </h2>
          <p class="text-text-default/70 mt-5 text-lg">
            Spraying everyone burns your domain and your budget. Filter your list by real buying signals so you
            reach the accounts that are actually in-market right now — not a random export.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              signals.map((s) => (
                <div class="border-border-light bg-theme-dark rounded-xl border p-4">
                  <p class="text-heading font-semibold">{s.k}</p>
                  <p class="text-text-default/60 mt-1 text-sm">{s.v}</p>
                </div>
              ))
            }
          </div>
        </div>
        <div class="from-primary/35 to-body -bg-linear-20 border-border-light rounded-3xl border p-8 md:p-10" data-aos="fade-up-sm" data-aos-delay="100">
          <p class="text-heading font-secondary text-xl font-semibold">Right person. Right time.</p>
          <p class="text-text-default/70 mt-3">
            A verified email at a company that's hiring for the exact role you help, or just raised a round, or
            is already running ads — that's the difference between "cold" and "warm enough to reply."
          </p>
          <div class="mt-6">
            <ButtonLink class="btn-md btn-primary" content={{ enable: true, label: "Explore signals", url: APP }} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verification / pay-per-valid -->
  <section class="bg-accent py-16 md:py-24">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center" data-aos="fade-up-sm">
        <Subtitle content="Verification" />
        <h2 class="font-secondary has-italic-text text-3xl md:text-4xl/tight">
          You only pay for <strong class="font-tertiary italic">emails that are real.</strong>
        </h2>
        <p class="text-text-default/70 mt-5 text-lg">
          Every address runs through SMTP plus platform-level checks (Microsoft, Google, and social-signal
          probes) before it reaches you. Invalid results cost you nothing — and never touch your domain.
        </p>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-3 text-center">
        {
          [
            { n: "1 credit", l: "= 1 verified, deliverable email" },
            { n: "0.20%", l: "measured false-positive rate" },
            { n: "Free", l: "catch-alls, clearly labeled — never billed" },
          ].map((x) => (
            <div class="border-border-light bg-theme-dark rounded-2xl border p-8">
              <p class="text-heading font-secondary text-3xl font-bold">{x.n}</p>
              <p class="text-text-default/70 mt-2 text-sm">{x.l}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Finish the job -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center" data-aos="fade-up-sm">
        <Subtitle content="Finish the job" />
        <h2 class="font-secondary has-italic-text text-3xl md:text-4xl/tight">
          Find the decision-maker. <strong class="font-tertiary italic">Then reach them.</strong>
        </h2>
        <p class="text-text-default/70 mt-5 text-lg">
          Hand us a company domain and we'll find the right decision-maker's verified email. Then export a clean
          CSV, or push straight into Instantly, Smartlead, PlusVibe, or SendEmAll's own sequencer — no
          manual re-import.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <ButtonLink class="btn-md btn-primary" content={{ enable: true, label: "Create your account", url: APP }} />
          <ButtonLink class="btn-md btn-outline-primary" content={{ enable: true, label: "Compare plans", url: "/pricing" }} />
        </div>
      </div>
    </div>
  </section>
</Base>
