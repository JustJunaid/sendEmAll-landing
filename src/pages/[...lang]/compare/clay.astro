---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import ComparePage from "@/layouts/components/sections/ComparePage.astro";

export function getStaticPaths() {
  return generatePaths();
}

const features = [
  { name: "Data enrichment", competitor: "150+ providers", sendemall: "Verified emails, valid-only" },
  { name: "Sends emails", competitor: "No", sendemall: "Built-in sequencer" },
  { name: "Sending infrastructure", competitor: "No", sendemall: "Done for you" },
  { name: "Warmup", competitor: "No", sendemall: "Included" },
  { name: "Pricing model", competitor: "Per-row credits", sendemall: "Flat, from $59/mo" },
  { name: "Pay only for valid emails", competitor: "No", sendemall: "Yes" },
];

const theyDoBetter = [
  { title: "Flexible data orchestration", description: "Clay's spreadsheet-based workflow builder is powerful for custom enrichment flows. If you need maximum flexibility in how you combine data sources, Clay is hard to beat." },
  { title: "Huge provider network", description: "One of the largest sets of data-provider integrations available — great for teams that need very specific enrichment combinations." },
  { title: "Developer-friendly workflows", description: "Technical teams love building custom Clay tables with formulas, API calls, and conditional logic." },
];

const weDoBetter = [
  { title: "Full execution, not just data", description: "Clay stops at enrichment. SendEmAll finds contacts, verifies emails, and sends — one platform instead of stitching a stack together." },
  { title: "Sending infrastructure included", description: "Clay does not send emails; you still need a sequencer, domains, mailboxes, and warmup. SendEmAll builds all four in and provisions the infrastructure for you." },
  { title: "Simple, predictable pricing", description: "Clay's per-row credits deplete unpredictably. SendEmAll is flat — from $59/mo — and you only pay for verified, valid emails." },
  { title: "Verified, not just enriched", description: "Clay enriches rows you already have. We deliver decision-maker emails verified before they reach you, so your bounce rate stays low." },
];
---

<Base
  title="Best Clay Alternative for Cold Email (2026) | SendEmAll"
  disableTagline={true}
  description="Clay orchestrates data. SendEmAll runs your whole outbound pipeline — verified leads from $59/mo, a $99 unlimited-seat sequencer, and done-for-you infrastructure — on flat, predictable pricing."
>
  <ComparePage
    competitor="Clay"
    description="Clay orchestrates data. SendEmAll runs the whole pipeline — find, verify, and send — with flat pricing and verified-only billing."
    competitorPrice="Per-row credits"
    competitorPriceNote="Enrichment and workflow automation only — no sending, infrastructure, or verified-only billing. Credit costs scale with usage."
    sendemallPrice="From $59/mo"
    features={features}
    theyDoBetter={theyDoBetter}
    weDoBetter={weDoBetter}
    integrationNote="Clay is great for complex enrichment workflows. If you want the full pipeline without building it yourself, SendEmAll handles finding, verifying, and sending in one place."
  />
</Base>
