---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import ComparePage from "@/layouts/components/sections/ComparePage.astro";

export function getStaticPaths() {
  return generatePaths();
}

const features = [
  { name: "Personalization", competitor: "Image/video", sendemall: "AI copy from research" },
  { name: "Verified potential buyers", competitor: "Basic finder", sendemall: "Apollo & Sales Nav, verified" },
  { name: "Pay only for valid emails", competitor: "No", sendemall: "Yes" },
  { name: "Warmup", competitor: "Add-on", sendemall: "Included" },
  { name: "Sending infrastructure", competitor: "BYO", sendemall: "Done for you" },
  { name: "Sequencer", competitor: "Paid per seat", sendemall: "$99 flat, unlimited seats" },
];

const theyDoBetter = [
  { title: "Visual personalization", description: "Lemlist pioneered image and video personalization in cold emails. If personalized visuals are core to your outreach, they do it best." },
  { title: "Multi-channel sequences", description: "LinkedIn steps plus email in one sequence — great if you need coordinated multi-channel outreach." },
  { title: "Established brand and community", description: "A large community with extensive tutorials, templates, and shared campaigns to learn from." },
];

const weDoBetter = [
  { title: "Finds the people to email", description: "Lemlist personalizes emails; it doesn't build your list. SendEmAll scrapes Apollo and Sales Navigator and verifies every address, so you're personalizing to real, valid contacts." },
  { title: "Sending infrastructure included", description: "Lemlist expects you to bring your own domains and mailboxes. SendEmAll provisions, configures, and manages them for you." },
  { title: "Warmup included", description: "Warmup is built in at no extra cost — there's no separate per-inbox add-on to buy." },
  { title: "Verified-only billing", description: "You pay only for valid emails, and the sequencer is one flat price with unlimited seats — a full outbound stack without the per-seat tax." },
];
---

<Base
  title="Best Lemlist Alternative for Cold Email (2026) | SendEmAll"
  disableTagline={true}
  description="Lemlist personalizes emails. SendEmAll finds the right people to personalize for — verified leads, built-in warmup, and done-for-you infrastructure from $59/mo."
>
  <ComparePage
    competitor="Lemlist"
    description="Lemlist personalizes emails. SendEmAll finds the right people to personalize for — and verifies every address before you send."
    competitorPrice="From $69/mo per seat"
    competitorPriceNote="Per-seat pricing. Warmup and lead finding vary by plan. No done-for-you sending infrastructure."
    sendemallPrice="From $59/mo"
    features={features}
    theyDoBetter={theyDoBetter}
    weDoBetter={weDoBetter}
    integrationNote="Love Lemlist for multi-channel and LinkedIn? Use SendEmAll to find and verify your leads, then push them into Lemlist. Or run everything in SendEmAll if email is your primary channel."
  />
</Base>
