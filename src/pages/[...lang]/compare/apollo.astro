---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import ComparePage from "@/layouts/components/sections/ComparePage.astro";

export function getStaticPaths() {
  return generatePaths();
}

const features = [
  { name: "Contact data", competitor: "Raw database", sendemall: "Your accounts + our lake, verified" },
  { name: "Pay only for valid emails", competitor: "No", sendemall: "Yes" },
  { name: "Email verification", competitor: "Included", sendemall: "Included" },
  { name: "Sending infrastructure", competitor: "No", sendemall: "Done for you" },
  { name: "Sequencer", competitor: "Basic sequences", sendemall: "$99 flat, unlimited seats" },
  { name: "LinkedIn steps in sequences", competitor: "Manual tasks", sendemall: "Automated — 1 account included" },
  { name: "Buying signals (ads, tech stack)", competitor: "Limited filters", sendemall: "Included" },
];

const theyDoBetter = [
  { title: "Massive contact database", description: "Apollo has a huge searchable database. If you want raw volume and firmographic filtering in one place, that scale is real." },
  { title: "CRM features", description: "Built-in CRM with deal tracking and pipeline management, if you want outreach and CRM in one tool." },
  { title: "A free tier to test", description: "Apollo offers a free plan to try before you commit." },
];

const weDoBetter = [
  { title: "Verified, not raw", description: "Apollo hands you a database to filter — bounces included. SendEmAll verifies every email before delivery, and you only pay for the valid ones." },
  { title: "Full sending infrastructure", description: "Apollo has basic sequences but no sending infrastructure. We provision domains, mailboxes, DNS, and warmup so your emails land." },
  { title: "Bring your own Apollo account", description: "Already pay for Apollo? Connect your account and SendEmAll scrapes it cleanly, verifies every address, and delivers valid-only results — no per-reveal credit fees." },
  { title: "No lock-in", description: "Send from our unlimited-seat sequencer, or push your verified leads to Instantly, Smartlead, or any tool you already use — exporting is free." },
];
---

<Base
  title="Best Apollo Alternative for Cold Email (2026) | SendEmAll"
  disableTagline={true}
  description="Apollo gives you a raw database that bounces. SendEmAll gives you verified emails — and you only pay for the valid ones. Bring your own Apollo account or start fresh."
>
  <ComparePage
    competitor="Apollo"
    description="Apollo gives you a raw database that bounces. SendEmAll gives you verified emails — you only pay for the valid ones. Bring your own Apollo account, or start fresh."
    competitorPrice="From $49/mo per seat"
    competitorPriceNote="Per-seat pricing, typically billed annually. Email credits deplete quickly at scale, and exports bounce."
    sendemallPrice="From $59/mo"
    features={features}
    theyDoBetter={theyDoBetter}
    weDoBetter={weDoBetter}
    integrationNote="Already using Apollo? Connect your account and SendEmAll scrapes it cleanly, verifies every email, and delivers valid-only results — no bounces, no per-reveal fees."
  />
</Base>
