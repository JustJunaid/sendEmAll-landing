---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const APP = "https://app.sendemall.com/register";

// Product + Offer structured data for pricing rich snippets
const pricingSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: "SendEmAll",
  description:
    "Find verified B2B buyers and run your outbound. You only pay for valid, verified emails. Plans from $59/mo.",
  brand: { "@type": "Brand", name: "SendEmAll" },
  url: "https://www.sendemall.com/pricing",
  offers: [
    {
      "@type": "Offer",
      name: "Starter",
      price: "59",
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", billingDuration: "P1M" },
      description: "25,000 verified-email credits per month.",
      availability: "https://schema.org/InStock",
      url: "https://www.sendemall.com/pricing",
    },
    {
      "@type": "Offer",
      name: "Growth",
      price: "79",
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", billingDuration: "P1M" },
      description: "50,000 verified-email credits per month.",
      availability: "https://schema.org/InStock",
      url: "https://www.sendemall.com/pricing",
    },
    {
      "@type": "Offer",
      name: "Sequencer",
      price: "99",
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", billingDuration: "P1M" },
      description: "Unlimited seats, workspaces, email sending and warmup. One LinkedIn account included.",
      availability: "https://schema.org/InStock",
      url: "https://www.sendemall.com/pricing",
    },
  ],
});

const check = `<svg class="text-primary h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
---

<Base
  metaTitle="Pricing — Pay only for verified emails | SendEmAll"
  disableTagline={true}
  metaDescription="Starter $59/mo for 25,000 credits, Growth $79/mo for 50,000. Sequencer $99/mo with unlimited seats and LinkedIn included. Mailboxes from $1.50/mo."
>
  <!-- 1. Hero -->
  <section class="py-20 md:py-28">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="font-secondary text-4xl md:text-5xl/tight has-italic-text mb-6" data-aos="fade-up-sm">
          Pay per valid email. <strong class="font-tertiary italic">Not per attempt.</strong>
        </h1>
        <p class="text-text-default/80 text-lg" data-aos="fade-up-sm" data-aos-delay="100">
          Credits buy your data — verified emails, buying signals, enrichments. 1 credit = 1 valid, verified email;
          catch-alls are labeled free. Sending is a flat subscription, never credits. No per-seat fees, no setup fees, cancel anytime.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Plans -->
  <section class="pb-20 md:pb-28">
    <div class="container">
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2 lg:grid-cols-4">
        <!-- Starter -->
        <div class="bg-theme-dark border-border-light flex flex-col rounded-2xl border p-8" data-aos="fade-up-sm">
          <h3 class="text-heading text-lg font-semibold">Starter</h3>
          <div class="mt-3 mb-1"><span class="text-heading text-4xl font-bold">$59</span><span class="text-text-default/60">/mo</span></div>
          <p class="text-text-default/70 mb-6 text-sm">25,000 credits a month — verified emails, signals & enrichments</p>
          <ul class="mb-8 flex-1 space-y-3 text-sm text-text-default/80">
            <li class="flex items-start gap-2" set:html={check + " Search 66M+ contacts & 10M+ companies"} />
            <li class="flex items-start gap-2" set:html={check + " Scrape your own Apollo & Sales Nav on a dedicated IP"} />
            <li class="flex items-start gap-2" set:html={check + " Describe your ICP in plain English"} />
            <li class="flex items-start gap-2" set:html={check + " Buying signals & enrichments"} />
            <li class="flex items-start gap-2" set:html={check + " 1 LinkedIn account included"} />
            <li class="flex items-start gap-2" set:html={check + " API, MCP server & CSV export"} />
          </ul>
          <a href={APP} class="btn btn-md btn-outline-primary w-full text-center">Create account</a>
        </div>

        <!-- Growth (Featured) -->
        <div class="bg-theme-dark border-primary relative flex flex-col rounded-2xl border-2 p-8" data-aos="fade-up-sm" data-aos-delay="100">
          <span class="bg-primary text-on-primary absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 text-xs font-bold tracking-wider uppercase">Best rate — $1.58 / 1,000</span>
          <h3 class="text-heading text-lg font-semibold">Growth</h3>
          <div class="mt-3 mb-1"><span class="text-heading text-4xl font-bold">$79</span><span class="text-text-default/60">/mo</span></div>
          <p class="text-text-default/70 mb-6 text-sm">50,000 credits — for teams running steady volume</p>
          <ul class="mb-8 flex-1 space-y-3 text-sm text-text-default/80">
            <li class="flex items-start gap-2" set:html={check + " Everything in Starter"} />
            <li class="flex items-start gap-2" set:html={check + " Double the monthly credits"} />
            <li class="flex items-start gap-2" set:html={check + " $1.58 per 1,000 valid emails — vs $2.36 on Starter"} />
          </ul>
          <a href={APP} class="btn btn-md btn-primary w-full text-center">Create account</a>
        </div>

        <!-- Sequencer -->
        <div class="bg-theme-dark border-border-light flex flex-col rounded-2xl border p-8" data-aos="fade-up-sm" data-aos-delay="200">
          <h3 class="text-heading text-lg font-semibold">Sequencer</h3>
          <div class="mt-3 mb-1"><span class="text-heading text-4xl font-bold">$99</span><span class="text-text-default/60">/mo</span></div>
          <p class="text-text-default/70 mb-6 text-sm">Unlimited email — seats, workspaces & sending</p>
          <ul class="mb-8 flex-1 space-y-3 text-sm text-text-default/80">
            <li class="flex items-start gap-2" set:html={check + " Unlimited seats, workspaces & email sending"} />
            <li class="flex items-start gap-2" set:html={check + " Multi-step sequences + A/B testing"} />
            <li class="flex items-start gap-2" set:html={check + " Unified inbox, warmup & reply detection"} />
            <li class="flex items-start gap-2" set:html={check + " LinkedIn outreach — 1 account included, +$39/mo each"} />
            <li class="flex items-start gap-2" set:html={check + " Works standalone — bring your own leads"} />
          </ul>
          <a href="https://sequencer.sendemall.com/register" class="btn btn-md btn-outline-primary w-full text-center">Start sending</a>
        </div>

        <!-- Infrastructure -->
        <div class="bg-theme-dark border-border-light flex flex-col rounded-2xl border p-8" data-aos="fade-up-sm" data-aos-delay="300">
          <h3 class="text-heading text-lg font-semibold">Infrastructure</h3>
          <div class="mt-3 mb-1"><span class="text-text-default/60 text-lg">from </span><span class="text-heading text-4xl font-bold">$1.50</span><span class="text-text-default/60">/mailbox/mo</span></div>
          <p class="text-text-default/70 mb-6 text-sm">SMTP $1.50 · Google & Microsoft $3.50 · Azure $40/tenant</p>
          <ul class="mb-8 flex-1 space-y-3 text-sm text-text-default/80">
            <li class="flex items-start gap-2" set:html={check + " Provisioned for you in minutes"} />
            <li class="flex items-start gap-2" set:html={check + " SPF, DKIM & DMARC set up automatically"} />
            <li class="flex items-start gap-2" set:html={check + " Buy, pre-age, or bring your own domains"} />
            <li class="flex items-start gap-2" set:html={check + " Pre-warmed mailboxes available"} />
            <li class="flex items-start gap-2" set:html={check + " Works with any sequencer"} />
          </ul>
          <a href="/mailboxes" class="btn btn-md btn-outline-primary w-full text-center">See mailboxes</a>
        </div>
      </div>

      <div class="mx-auto mt-8 max-w-xl space-y-2 text-center" data-aos="fade-up-sm">
        <p class="text-text-default/80 text-sm">
          <span class="text-primary mr-1.5 font-semibold">&#10003;</span> Every new account starts with <strong class="text-heading">500 free credits</strong> — no card required.
        </p>
        <p class="text-text-default/80 text-sm">
          <span class="text-primary mr-1.5 font-semibold">&#10003;</span> Under 3% bounce on the leads we provide, or we refund your first month.
        </p>
        <p class="text-text-default/80 text-sm">
          <span class="text-primary mr-1.5 font-semibold">&#10003;</span> In-app chat support on every plan — stuck anywhere, we're a message away.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Credit model -->
  <section class="pb-20 md:pb-28">
    <div class="container max-w-2xl">
      <h2 class="text-heading mb-3 text-center text-2xl md:text-3xl font-bold" data-aos="fade-up-sm">How credits work</h2>
      <p class="text-text-default/70 mb-10 text-center" data-aos="fade-up-sm">
        One rule: <strong class="text-heading">1 credit = 1 verified, valid email delivered to you.</strong>
        Enrichments use credits at the rates below. Sending never does — that's the sequencer's flat subscription.
      </p>
      <div class="bg-theme-dark border-border-light overflow-hidden rounded-2xl border" data-aos="fade-up-sm" data-aos-delay="100">
        <table class="w-full text-left">
          <thead>
            <tr class="border-border-light border-b">
              <th class="text-heading px-6 py-4 text-sm font-semibold tracking-wider uppercase">Action</th>
              <th class="text-heading px-6 py-4 text-right text-sm font-semibold tracking-wider uppercase">Credits</th>
            </tr>
          </thead>
          <tbody class="text-text-default/80">
            <tr class="border-border-light/50 border-b"><td class="px-6 py-3.5"><strong class="text-heading">Verified, valid email delivered</strong></td><td class="text-heading px-6 py-3.5 text-right font-medium">1</td></tr>
            <tr class="border-border-light/50 border-b"><td class="px-6 py-3.5">Catch-all, invalid or risky result</td><td class="text-primary px-6 py-3.5 text-right font-medium">Free — labeled</td></tr>
            <tr class="border-border-light/50 border-b"><td class="px-6 py-3.5">Google or Meta ads detection</td><td class="text-heading px-6 py-3.5 text-right font-medium">1 per domain</td></tr>
            <tr class="border-border-light/50 border-b"><td class="px-6 py-3.5">Tech-stack detection</td><td class="text-heading px-6 py-3.5 text-right font-medium">1 per domain</td></tr>
            <tr><td class="px-6 py-3.5">LinkedIn Open Profile check</td><td class="text-heading px-6 py-3.5 text-right font-medium">3</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-text-default/60 mt-4 text-center text-sm">
        That's <strong class="text-heading">$2.36 per 1,000 verified emails</strong> on Starter, and
        <strong class="text-heading">$1.58</strong> on Growth. Full enrichment rates are shown in the app before you run anything.
      </p>
    </div>
  </section>

  <!-- 4. Stack tax comparison -->
  <section class="bg-accent py-20 md:py-28">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-heading text-2xl md:text-3xl font-bold" data-aos="fade-up-sm">What you'd stitch together otherwise</h2>
      </div>
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        <div class="bg-theme-dark border-border-light rounded-2xl border p-8" data-aos="fade-up-sm">
          <h3 class="font-secondary text-text-default/60 mb-6 text-center text-lg font-medium">Five tools, five bills</h3>
          <div class="space-y-3 text-sm">
            {[["Lead database","$49–119"],["Email verification","$20–50"],["Sending tool","$47–97"],["Warmup tool","$25–59"],["Enrichment","$49–149"]].map(([k,v]) => (
              <div class="border-border-light/50 flex items-center justify-between border-b pb-3">
                <span class="text-text-default/80">{k}</span><span class="text-heading font-medium">{v}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 rounded-xl bg-danger/10 p-4 text-center">
            <p class="text-sm text-danger">Total monthly cost</p>
            <p class="text-2xl font-bold text-danger">$190–474<span class="text-base font-normal">/mo</span></p>
          </div>
        </div>
        <div class="bg-theme-dark border-primary/50 relative rounded-2xl border-2 p-8" data-aos="fade-up-sm" data-aos-delay="100">
          <h3 class="font-secondary text-primary mb-6 text-center text-lg font-medium">SendEmAll</h3>
          <div class="space-y-3 text-sm">
            {[["Verified B2B leads","$59/mo"],["Email finding + verification","In the credit"],["Email warmup","Included"],["Sequencer + unified inbox","$99/mo"],["LinkedIn outreach","1 account included"]].map(([k,v]) => (
              <div class="border-border-light/50 flex items-center justify-between border-b pb-3">
                <span class="text-text-default/80">{k}</span><span class="text-heading font-medium">{v}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 rounded-xl bg-primary/10 p-4 text-center">
            <p class="text-primary text-sm">Total monthly cost</p>
            <p class="text-primary text-2xl font-bold">$158<span class="text-base font-normal">/mo</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Credit calculator -->
  <section class="py-20 md:py-28">
    <div class="container max-w-2xl">
      <div class="bg-theme-dark border-border-light rounded-2xl border p-8 md:p-12" data-aos="fade-up-sm">
        <h2 class="text-heading mb-2 text-center text-2xl md:text-3xl font-bold">Estimate your plan</h2>
        <p class="text-text-default/70 mb-10 text-center">How many verified emails do you need per month? Add the sequencer at a flat $99/mo when you're ready to send.</p>
        <div class="mb-10">
          <div class="text-text-default/70 mb-2 flex justify-between text-sm">
            <span>1,000</span>
            <span id="calc-emails" class="text-heading text-lg font-semibold">25,000</span>
            <span>100,000+</span>
          </div>
          <input type="range" id="calc-slider" min="1000" max="100000" step="1000" value="25000" class="bg-border-light h-2 w-full cursor-pointer appearance-none rounded-full accent-[var(--se-primary)]" />
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="text-center"><p class="text-text-default/70 mb-1 text-sm">Recommended plan</p><p id="calc-plan" class="text-primary text-2xl font-bold">Starter</p></div>
          <div class="text-center"><p class="text-text-default/70 mb-1 text-sm">Monthly cost</p><p id="calc-cost" class="text-heading text-2xl font-bold">$59</p></div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        const slider = document.getElementById("calc-slider");
        const emailsEl = document.getElementById("calc-emails");
        const planEl = document.getElementById("calc-plan");
        const costEl = document.getElementById("calc-cost");
        function plan(n) {
          if (n <= 25000) return { name: "Starter", cost: "$59" };
          if (n <= 50000) return { name: "Growth", cost: "$79" };
          return { name: "Talk to us", cost: "Custom" };
        }
        function update() {
          const n = parseInt(slider.value, 10);
          const p = plan(n);
          emailsEl.textContent = n.toLocaleString();
          planEl.textContent = p.name;
          costEl.textContent = p.cost;
        }
        slider.addEventListener("input", update);
        update();
      })();
    </script>
  </section>

  <!-- 6. FAQ -->
  <section class="pb-20 md:pb-28">
    <div class="container max-w-3xl">
      <h2 class="text-heading mb-12 text-center text-2xl md:text-3xl font-bold" data-aos="fade-up-sm">Frequently asked questions</h2>
      <div class="hs-accordion-group space-y-4" data-aos="fade-up-sm" data-aos-delay="100">
        {[
          ["What counts as a credit?", "One credit equals one verified, valid email delivered to you. Enrichments — verification, ads and tech-stack detection, LinkedIn Open Profile checks — use credits too, at the rates shown in the app. Catch-alls are labeled free, and you're never charged for invalid results."],
          ["What do the 500 free credits cover?", "Every new account gets 500 credits, no card required — enough to pull 500 verified emails from our 66M-contact lake, or to test email verification, the email finder, decision-maker lookup, and buying signals. The one thing they don't cover is scraping your own Apollo or Sales Navigator account: that runs on a dedicated residential IP reserved for you, so it starts with a paid plan."],
          ["How much is the sequencer?", "$99/mo, everything unlimited — seats, workspaces, sending, warmup, reply management. It's built for agencies done paying per seat. Prefer your own tool? Push your SendEmAll leads and mailboxes to Instantly or PlusVibe free — no lock-in."],
          ["Can I change plans?", "Upgrade, downgrade, or cancel anytime. Changes take effect on your next billing cycle. No contracts, no lock-in."],
          ["What if I need more than 50,000 credits?", "Reach out and we'll sort out a plan that fits your volume."],
          ["Do unused credits roll over?", "Credits reset monthly. Pick the plan that matches your outbound volume so nothing goes to waste."],
          ["Does LinkedIn cost extra?", "Every plan includes one LinkedIn sending account on its own dedicated residential IP. Add more at $39/mo each. LinkedIn sending spends your own LinkedIn allowances — never your SendEmAll credits."],
          ["Do credits pay for sending?", "No. Credits only buy data — verified emails and enrichments. Sending is the sequencer's flat $99/mo subscription, however much you send."],
          ["How much does the sending infrastructure cost?", "SMTP mailboxes are $1.50 per month and Google Workspace or Microsoft 365 are $3.50 — SPF, DKIM, DMARC and warmup set up for you. For volume, an Azure shared tenant is $40/mo and carries 100 mailboxes on one domain. Buy domains at the live registrar price, pick from our pre-aged inventory, or bring your own. See the mailboxes page for details."],
          ["What if I get stuck?", "Chat with us from inside the app — real people, during working hours, on every plan. Wherever you hit a wall, we're a message away."],
        ].map(([q, a], i) => (
          <div class="hs-accordion bg-theme-dark border-border-light rounded-xl border" id={`pfaq-${i}`}>
            <button class="hs-accordion-toggle text-heading hover:text-primary flex w-full items-center justify-between px-6 py-5 text-left font-medium transition-colors" aria-expanded="false" aria-controls={`pfaq-${i}-body`}>
              {q}
              <svg class="hs-accordion-active:rotate-180 text-text-default h-5 w-5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id={`pfaq-${i}-body`} class="hs-accordion-content hidden overflow-hidden transition-[height] duration-300" role="region">
              <p class="text-text-default/80 px-6 pb-5">{a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. CTA -->
  <section class="pb-20 md:pb-28">
    <div class="container text-center">
      <h2 class="text-heading mb-6 text-3xl md:text-4xl font-bold has-italic-text" data-aos="fade-up-sm">
        Ready to reach <strong class="font-tertiary italic">verified buyers?</strong>
      </h2>
      <div class="flex flex-col justify-center gap-4 sm:flex-row" data-aos="fade-up-sm" data-aos-delay="100">
        <a href={APP} class="btn btn-md btn-primary">Create your account</a>
        <a href="/contact" class="btn btn-md btn-outline-primary">Talk to us</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={pricingSchema} />
</Base>
