---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}
---

<Base
  metaTitle="About SendEmAll | Our Story"
  disableTagline={true}
  metaDescription="Your data and your deliverability are the same problem. We built SendEmAll so bad leads can't burn the domain you spent weeks warming — verified buyers and real deliverability in one system."
>
  <!-- Hero -->
  <section class="py-24 lg:py-32">
    <div class="container text-center">
      <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary" data-aos="fade-up-sm">Our Story</span>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl" data-aos="fade-up-sm" data-aos-delay="100">
        Bad data burns good domains
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-default/70" data-aos="fade-up-sm" data-aos-delay="200">
        That's the problem we built SendEmAll to end — by owning both halves of outbound, the buyers you reach
        and the inbox you land in, as one system.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 lg:py-28">
    <div class="container">
      <div class="mx-auto max-w-3xl" data-aos="fade-up-sm">
        <h2 class="mb-8 text-3xl font-bold sm:text-4xl">The problem we lived every day</h2>
        <div class="space-y-6 text-lg leading-relaxed text-text-default/80">
          <p>
            We ran outbound the way everyone does: a finder for data, a verifier bolted on, a sender that
            never spoke to either. Five tools, five bills, and a CSV shuttling between them.
          </p>
          <p>
            Then the same thing happened, over and over. You buy a list. A chunk of it is guesswork. You send,
            and the bounces land on the domains you spent three weeks warming. Reputation drops, replies dry
            up, and <strong class="text-heading">not one tool in the stack tells you why you're in spam</strong> &mdash;
            because the tool that sold you the data has no stake in whether it delivers.
          </p>
          <p>
            That's the seam we built SendEmAll to close. One system where the data and the deliverability
            answer to each other: every address verified before it ever touches your domain, mailboxes and
            warmup handled in the same place, and billing that only charges for addresses that are real. Our
            incentives point the same way yours do &mdash; we make money when the email is valid, not when
            you send.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20 lg:py-28">
    <div class="container">
      <div class="mx-auto max-w-3xl rounded-2xl border border-border-light bg-accent p-12 text-center" data-aos="fade-up-sm">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">Our Mission</span>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Outbound that earns its reply</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-text-default/70">
          Give every team &mdash; not just the ones with a full-time ops hire &mdash; outbound where the data is
          verified, the domain is protected, and the results are worth paying for.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="py-20 lg:py-28">
    <div class="container">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold sm:text-4xl" data-aos="fade-up-sm">The numbers behind the platform</h2>
      </div>
      <div class="mx-auto grid max-w-4xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { stat: "66M+", label: "Verified B2B contacts in the data lake" },
          { stat: "18", label: "Data providers integrated into one pipeline" },
          { stat: "0.20%", label: "False-positive rate on verified emails" },
          { stat: "4", label: "Pipeline stages handled automatically" },
        ].map((item, i) => (
          <div class="rounded-2xl border border-border-light bg-accent p-8 text-center" data-aos="fade-up-sm" data-aos-delay={i * 75}>
            <span class="block text-4xl font-bold text-primary">{item.stat}</span>
            <p class="mt-3 text-sm text-text-default/70">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-28">
    <div class="container">
      <div class="mx-auto max-w-3xl rounded-2xl border border-border-light bg-accent p-12 text-center" data-aos="fade-up-sm">
        <h2 class="text-3xl font-bold sm:text-4xl">Run outbound that lands</h2>
        <p class="mx-auto mt-4 max-w-xl text-text-default/70">
          Verified buyers, protected domains, and a bill that only counts what's real.
        </p>
        <p class="text-text-default/80 mx-auto mt-6 max-w-xl text-sm">
          <span class="text-primary mr-1.5 font-semibold">&#10003;</span> Under 3% bounce on the leads we provide, or we refund your first month.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="https://app.sendemall.com/register" class="btn btn-md btn-primary">Create your account</a>
          <a href="/pricing" class="btn btn-md btn-outline-primary">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>
