---
/**
 * Cookie Consent Banner
 * Uses vanilla-cookieconsent v3 by Orestbida
 * - GA4 Consent Mode v2 (defaults denied, updates on accept)
 * - Conditional loading of Clarity and Intercom
 * - Dark theme matching SendEmAll brand
 */
---

<!-- GA4 Consent Mode v2: set defaults BEFORE gtag loads -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'analytics_storage': 'denied',
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'functionality_storage': 'denied',
    'personalization_storage': 'denied',
    'security_storage': 'granted',
    'wait_for_update': 500,
  });
</script>

<script>
  import { loadStylesheet } from "@/lib/utils/loadStylesheet";
  // `?url` keeps Vite from hoisting this stylesheet into <head>. A plain
  // `import("...css")` is resolved at build time, so the 32 KB banner stylesheet
  // was shipping render-blocking on all 82 pages — including for the non-GDPR
  // visitors this branch is written to spare.
  import cookieConsentStylesUrl from "vanilla-cookieconsent/dist/cookieconsent.css?url";

  // vanilla-cookieconsent CSS + JS are dynamically loaded ONLY in the
  // consent-required branch below, so non-GDPR visitors never download the
  // banner bundle. Third-party loaders are deferred to idle time so they never
  // compete with first paint / the hero LCP.
  function whenIdle(fn: () => void) {
    const w = window as any;
    if (typeof w.requestIdleCallback === "function") {
      w.requestIdleCallback(fn, { timeout: 3000 });
    } else {
      setTimeout(fn, 1200);
    }
  }

  // --- Script loaders (only called after consent) ---

  function loadGA4() {
    if (document.querySelector('script[src*="googletagmanager.com/gtag"]')) return;
    const s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=G-4WT843MDLE";
    document.head.appendChild(s);

    // Use the global gtag defined in the inline script above —
    // redefining with TypeScript rest params would push Arrays instead of
    // Arguments objects, which gtag.js silently ignores.
    const gtag: (...args: any[]) => void = (window as any).gtag;
    gtag("js", new Date());
    gtag("config", "G-4WT843MDLE");
  }

  // PostHog — product analytics, session replay, funnels, feature flags/experiments.
  // Replaces Microsoft Clarity (session replay is native). Consent-gated like GA4.
  /** Local dev and preview hosts must never reach the production project —
   *  our own `npm run dev` sessions would otherwise land in the same funnels
   *  and experiment as real visitors and quietly skew them. */
  function isTrackableHost() {
    const h = location.hostname;
    return !(
      h === "localhost" ||
      h === "127.0.0.1" ||
      h === "[::1]" ||
      h.endsWith(".localhost") ||
      h.endsWith(".local") ||
      h.endsWith(".vercel.app")
    );
  }

  async function loadPostHog() {
    const key = import.meta.env.PUBLIC_POSTHOG_KEY;
    if (!key) return;
    if (!isTrackableHost()) return;
    if ((window as any).posthog?.__loaded) return;
    const posthog = (await import("posthog-js")).default;
    posthog.init(key, {
      api_host: import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com",
      ui_host: import.meta.env.PUBLIC_POSTHOG_UI_HOST || "https://us.posthog.com",
      person_profiles: "identified_only",
      capture_pageview: true,
      capture_pageleave: true,
      autocapture: true,
      cross_subdomain_cookie: true, // stitch to app.sendemall.com when the app adds PostHog
      persistence: "localStorage+cookie",
      session_recording: { maskAllInputs: true },
      respect_dnt: true,
    });
    (window as any).posthog = posthog;
    // Activate any A/B experiments on the page once feature flags resolve.
    const { initExperiments } = await import("@/lib/analytics/experiment");
    initExperiments();
  }

  function loadIntercom() {
    if ((window as any).Intercom) return;
    (window as any).intercomSettings = {
      api_base: "https://api-iam.intercom.io",
      app_id: "cefdxuko",
    };
    const w = window as any;
    const d = document;
    const i = function (...args: any[]) { i.c(args); } as any;
    i.q = [] as any[];
    i.c = function (args: any) { i.q.push(args); };
    w.Intercom = i;
    const s = d.createElement("script");
    s.type = "text/javascript";
    s.async = true;
    s.src = "https://widget.intercom.io/widget/cefdxuko";
    const x = d.getElementsByTagName("script")[0];
    x.parentNode?.insertBefore(s, x);
  }

  // --- Update GA4 consent state ---

  function updateConsent(analyticsGranted: boolean, marketingGranted: boolean) {
    const gtag: (...args: any[]) => void = (window as any).gtag;
    gtag("consent", "update", {
      analytics_storage: analyticsGranted ? "granted" : "denied",
      ad_storage: marketingGranted ? "granted" : "denied",
      ad_user_data: marketingGranted ? "granted" : "denied",
      ad_personalization: marketingGranted ? "granted" : "denied",
      functionality_storage: marketingGranted ? "granted" : "denied",
      personalization_storage: marketingGranted ? "granted" : "denied",
    });
  }

  // --- Geolocation-based consent check ---
  // Primary: reads cc_geo cookie set by Vercel edge middleware (x-vercel-ip-country).
  // Fallback: timezone detection for local dev or if cookie is missing.
  function requiresConsent(): boolean {
    // Check middleware-set cookie first
    const match = document.cookie.match(/(?:^|;\s*)cc_geo=([01])/);
    if (match) return match[1] === "1";

    // Fallback: timezone (for local dev, first-load edge cases)
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      return tz.startsWith("Europe/") || tz.startsWith("Atlantic/");
    } catch {
      return true; // Default to showing banner if detection fails
    }
  }

  const consentRequired = requiresConsent();
  const isDev = location.hostname === "localhost" || location.hostname === "127.0.0.1";

  if (isDev) {
    // Dev environment: skip all analytics, load only Intercom for testing
    whenIdle(loadIntercom);
  } else if (!consentRequired) {
    // Non-GDPR region: auto-grant analytics, no banner. Consent state is set
    // immediately; the heavy third-party scripts (GA4, PostHog + session replay,
    // Intercom) are deferred to idle so they never block first paint.
    updateConsent(true, false);
    whenIdle(() => {
      loadGA4();
      loadPostHog();
      loadIntercom();
    });
  } else {

  // --- Initialize CookieConsent (GDPR/ePrivacy regions only) ---
  // Banner CSS + JS are imported on demand here only — never for US/non-GDPR.
  const [CookieConsent] = await Promise.all([
    import("vanilla-cookieconsent"),
    loadStylesheet(cookieConsentStylesUrl),
  ]);

  CookieConsent.run({
    guiOptions: {
      consentModal: {
        layout: "box inline",
        position: "bottom left",
      },
      preferencesModal: {
        layout: "box",
      },
    },

    categories: {
      necessary: {
        enabled: true,
        readOnly: true,
      },
      analytics: {
        autoClear: {
          cookies: [
            { name: /^_ga/ },
            { name: "_gid" },
            { name: /^ph_/ },
          ],
        },
      },
    },

    onFirstConsent: ({ cookie }) => {
      const hasAnalytics = cookie.categories.includes("analytics");
      updateConsent(hasAnalytics, false);
      if (hasAnalytics) { loadGA4(); loadPostHog(); }
    },

    onConsent: ({ cookie }) => {
      const hasAnalytics = cookie.categories.includes("analytics");
      updateConsent(hasAnalytics, false);
      if (hasAnalytics) { loadGA4(); loadPostHog(); }
    },

    onChange: ({ cookie }) => {
      const hasAnalytics = cookie.categories.includes("analytics");
      updateConsent(hasAnalytics, false);
      if (hasAnalytics) { loadGA4(); loadPostHog(); }
    },

    language: {
      default: "en",
      translations: {
        en: {
          consentModal: {
            title: "We value your privacy",
            description:
              "We use cookies for analytics and to improve your experience. You can choose which cookies to allow.",
            acceptAllBtn: "Accept all",
            acceptNecessaryBtn: "Reject all",
            showPreferencesBtn: "Manage preferences",
          },
          preferencesModal: {
            title: "Cookie Preferences",
            acceptAllBtn: "Accept all",
            acceptNecessaryBtn: "Reject all",
            savePreferencesBtn: "Save preferences",
            sections: [
              {
                title: "Essential Cookies",
                description:
                  "These cookies are required for the site to function and cannot be disabled.",
                linkedCategory: "necessary",
              },
              {
                title: "Analytics",
                description:
                  "We use Google Analytics and PostHog to understand how visitors use our site. This helps us improve the experience.",
                linkedCategory: "analytics",
              },
            ],
          },
        },
      },
    },
  });

  // Intercom loads always — it's customer support (legitimate interest), not
  // marketing. Deferred to idle so it never blocks first paint.
  whenIdle(loadIntercom);

  } // end else (consent-required regions)
</script>

<!-- Dark theme overrides matching SendEmAll brand -->
<style is:global>
  :root {
    --cc-bg: #1a122e;
    --cc-primary-color: #d2b3f3;
    --cc-secondary-color: #a89bbe;
    --cc-text: #e2dce8;
    --cc-btn-primary-bg: #d2b3f3;
    --cc-btn-primary-color: #1a122e;
    --cc-btn-primary-hover-bg: #b896e8;
    --cc-btn-primary-hover-color: #1a122e;
    --cc-btn-secondary-bg: rgba(210, 179, 243, 0.1);
    --cc-btn-secondary-color: #d2b3f3;
    --cc-btn-secondary-hover-bg: rgba(210, 179, 243, 0.2);
    --cc-btn-secondary-hover-color: #d2b3f3;
    --cc-separator-border-color: rgba(210, 179, 243, 0.15);
    --cc-cookie-category-block-bg: rgba(210, 179, 243, 0.05);
    --cc-cookie-category-block-hover-bg: rgba(210, 179, 243, 0.1);
    --cc-overlay-bg: rgba(10, 6, 20, 0.7);
    --cc-toggle-on-bg: #d2b3f3;
    --cc-toggle-off-bg: rgba(210, 179, 243, 0.2);
    --cc-toggle-readonly-bg: rgba(210, 179, 243, 0.3);
    --cc-modal-border-radius: 1rem;
    --cc-btn-border-radius: 0.5rem;
  }
</style>
