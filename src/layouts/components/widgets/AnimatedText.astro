---
interface Props {
  class?: string;
  content: string;
  duration?: number;
  delay?: number;
  stagger?: number;
}

let {
  content,
  duration = 0.6,
  delay = 0,
  stagger = 0.1,
  ...rest
} = Astro.props;

let processedContent = "";
if (content) {
  const words = content.split(" "); // Split text into words
  processedContent = words
    .map(
      // Words are visible by default (LCP-safe). The entrance-animation hidden
      // state is applied via CSS only when JS is active (html.js-loaded) — see
      // the <style> below and the pre-paint fail-safe timer in Head.astro.
      (word: string) => `<span class="word">${word}</span>`,
    )
    .join(" ");
}
---

<div
  class:list={["animated-text", Astro.props.class]}
  set:html={processedContent}
  data-duration={duration}
  data-delay={delay}
  data-stagger={stagger}
  {...rest}
/>

<style is:global>
  /* LCP-safe reveal: animated words paint immediately by default so the hero
     heading (the LCP element) is never blocked by an unresolved JS animation.
     They are hidden for the entrance animation ONLY when the pre-paint script
     confirmed JS is live (html.js-loaded) and the fail-safe timer hasn't
     force-revealed them. motion sets inline styles to animate them back in. */
  .animated-text .word {
    display: inline-block;
    will-change: transform;
  }
  html.js-loaded .animated-text .word {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(10px);
  }
</style>

<script>
  import { animate, stagger, inView } from "motion";

  // Tell the <head> fail-safe timer that motion is alive, so it keeps the
  // pre-animation hidden state instead of force-revealing the text.
  (window as any).__animatedTextReady = true;

  const animatedTexts = document.querySelectorAll(".animated-text");

  animatedTexts.forEach((animatedText) => {
    const duration = parseFloat(
      animatedText.getAttribute("data-duration") as string,
    );
    const delay = parseFloat(animatedText.getAttribute("data-delay") as string);
    const dataStagger = parseFloat(
      animatedText.getAttribute("data-stagger") as string,
    );

    inView(animatedText, (element) => {
      const words = element.querySelectorAll(".word");
      const animation = animate(
        words,
        // @ts-expect-error
        { opacity: 1, y: 0, filter: "blur(0px)" },
        {
          duration: duration,
          delay: stagger(dataStagger, { startDelay: delay }), // Fixed here
          easing: "ease-out",
        },
      );

      // This will fire when the element leaves the viewport
      return () => {
        // animation.stop();
        // animate(element.querySelectorAll(".word"), {
        //   opacity: 0,
        //   y: 20,
        //   filter: "blur(10px)",
        // });
      };
    });
  });
</script>
