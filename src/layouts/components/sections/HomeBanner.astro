---
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import { markdownify } from "@/lib/utils/textConverter";
import type { Button, Section } from "@/types";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import Customers from "./Customers.astro";
import { plainify } from "@/lib/utils/textConverter";
import ButtonLink from "../buttons/ButtonLink.astro";
import VideoModal from "../widgets/VideoModal.astro";
import AnimatedText from "../widgets/AnimatedText.astro";
import type { customersSectionType } from "@/types";

// Type for this section data
type homeBannerSectionType = Section & {
  buttons: Button[];
  customers: customersSectionType;
  imageAlt?: string;
};

type Props = {
  content?: homeBannerSectionType;
};

// Fetching the default content for the this section
let defaultContent = (
  await getEntryCTM("sections", "home-banner", Astro.currentLocale)
)?.data as homeBannerSectionType;

// Enables content customization (e.g., title, description) with a fallback to 'defaultContent' if not provided.
// The 'content' prop should match the structure of 'defaultContent'.
// Allows using this section with different content across multiple pages.
// If 'content' is missing, 'defaultContent' will be used.
let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as homeBannerSectionType;

// Extracting required values from 'content' object
let { title, customers, description, image, imageAlt, buttons } =
  actualContent as homeBannerSectionType;

const videoButton = buttons.find((button) => button.type === "video");

// Hero A/B harness (PostHog flag `hero_headline`, experiment #453312).
// Headline and description swap TOGETHER as one message: `control` (value-led,
// from the content file) vs `product_led` — never mixed, so each cell reads as
// one coherent voice. `control` renders by default (SEO-safe single h1, no
// flash); initExperiments() swaps `hidden` once PostHog resolves the flag.
// Conversion is measured on `app_signed_in` (cross-subdomain identity), not
// clicks. Approved by Junaid 2026-08-27.
const heroVariants = [
  { variant: "control", text: title },
  { variant: "product_led", text: "Verified leads. Warmed mailboxes. **Email + LinkedIn sequences.**" },
  // Earlier candidates, parked — to try one later: uncomment it AND add the
  // matching variant key to the PostHog flag/experiment first.
  // { variant: "bounce", text: "Stop paying for **leads that bounce.**" },
  // { variant: "domain", text: "Cold email that lands — **without burning your domain.**" },
  // { variant: "one_system", text: "Right buyers, real deliverability — **one system.**" },
  // { variant: "agency", text: "Outbound for agencies. **Unlimited seats, one price.**" },
  // { variant: "rigged_stack", text: "Your outbound stack is rigged. **Here's the fix.**" },
  // { variant: "five_tools", text: "Find them and reach them. **One platform, not five tools.**" },
];

// Each headline cell's matching description — same flag, same variant keys.
const heroDescriptions = [
  { variant: "control", text: description },
  {
    variant: "product_led",
    text: "Search 66M+ B2B contacts and 10M+ companies — every email verified before it reaches you. Spin up Google and Microsoft mailboxes with warmup built in. Follow up on email and LinkedIn from one sequencer. Each piece works on its own.",
  },
];
---

<section>
  <div class="banner-gradient stretched-link relative">
    <div class="container">
      <div class="relative z-10 mx-auto max-w-4xl space-y-10">
        <div>
          <p
            class="text-primary font-secondary mb-4 text-center text-xs font-semibold tracking-[0.25em] uppercase"
            data-aos="fade-up-sm">
            The all-in-one outbound platform
          </p>
          {
            title && (
              <h1 class="has-italic-text font-secondary mb-6 text-center text-5xl text-heading capitalize md:text-7xl/tight">
                {heroVariants.map((v) => (
                  <span
                    class="block"
                    data-ab="hero_headline"
                    data-ab-variant={v.variant}>
                    <AnimatedText
                      content={markdownify(v.text)}
                      stagger={0.04}
                      duration={0.5}
                    />
                  </span>
                ))}
              </h1>
            )
          }
          {
            description && (
              <div>
                {heroDescriptions.map((d) => (
                  <div data-ab="hero_headline" data-ab-variant={d.variant}>
                    <AnimatedText
                      class="text-center text-lg/normal"
                      stagger={0.008}
                      delay={0.15}
                      duration={0.5}
                      content={markdownify(d.text)}
                    />
                  </div>
                ))}
              </div>
            )
          }
        </div>
        <div
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="900"
          class="has-video-modal flex flex-wrap items-center justify-center gap-5">
          {
            buttons &&
              buttons.map((button: Button, index: number) =>
                button.type !== "video" ? (
                  button.url?.includes("register") || button.url?.includes("app.sendemall.com") || button.url?.includes("signup") ? (
                    <ButtonLink
                      content={button}
                      class="btn-md btn-primary btn-has-icon group relative z-0 flex items-center gap-4 [&>.label]:z-20">
                      <span class="flex h-6 w-12 items-center justify-center rounded-full bg-dark/15">
                        <OptimizedImage
                          alt=""
                          class="h-5 w-5 transition-all duration-300 group-hover:translate-x-1"
                          src="/images/icons/svg/star.svg"
                        />
                      </span>
                    </ButtonLink>
                  ) : (
                    <ButtonLink
                      content={button}
                      class="btn-md btn-outline-primary" />
                  )
                ) : (
                  <ButtonLink
                    tag={"button"}
                    content={button}
                    type="button"
                    title="Play Video"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls={"#" + button.video?.id}
                    data-hs-overlay={"#" + button.video?.id}
                    data-hs-overlay-options={`{"emulateScrollbarSpace" : true}`}
                    class="video-modal-toggle btn-md btn-primary btn-has-icon group after:bg-primary/25 relative z-0 flex items-center gap-4 after:pointer-events-none after:absolute after:inset-0 after:z-10 after:size-full [&>.label]:z-20">
                    <span class="has-animated-waves waves-white waves-sm relative z-20 flex h-6 w-6 items-center justify-center rounded-full">
                      <OptimizedImage
                        alt=""
                        inlineSvg={true}
                        class="text-primary ml-px h-2 w-2"
                        src="/images/icons/svg/play-icon.svg"
                      />
                    </span>

                    {/* Background Images */}
                    {button?.video?.src && (
                      <video
                        autoplay
                        muted
                        loop
                        playsinline
                        class="absolute top-0 left-0 z-0 z-10 h-full w-full object-cover"
                        {...{
                          src: button?.video?.src.startsWith("http")
                            ? button?.video?.src
                            : null,
                        }}>
                        {!button?.video?.src.startsWith("http") && (
                          <source src={button?.video?.src} type="video/mp4" />
                        )}
                        Your browser does not support the video tag.
                      </video>
                    )}
                  </ButtonLink>
                ),
              )
          }
        </div>

        {/* Risk reversal + proof — sits tight under the CTAs */}
        <div class="!mt-6 space-y-6 text-center" data-aos="fade-up-sm" data-aos-delay="200">
          <div class="mx-auto max-w-xl space-y-2">
            <p class="text-text-default/80 text-sm">
              <span class="text-primary mr-1.5 font-semibold">&#10003;</span> Start with <strong class="text-heading">500 free credits</strong> — no card required.
            </p>
            <p class="text-text-default/80 text-sm">
              <span class="text-primary mr-1.5 font-semibold">&#10003;</span> Under 3% bounce on the leads we provide, or we refund your first month.
            </p>
          </div>
          {/* Intent router — a visitor who already knows which product they came
              for shouldn't have to scroll the whole story to find its door. Each
              link lands on the pillar page, which sells and then routes to that
              product's own register (app / sequencer / infra). */}
          <p class="text-text-default/60 text-sm">
            Know what you need?
            <a href="/leads" class="text-primary font-medium underline-offset-4 hover:underline">Leads</a> ·
            <a href="/sequencer" class="text-primary font-medium underline-offset-4 hover:underline">Sequencer</a> ·
            <a href="/mailboxes" class="text-primary font-medium underline-offset-4 hover:underline">Mailboxes</a> ·
            <a href="/linkedin-outreach" class="text-primary font-medium underline-offset-4 hover:underline">LinkedIn</a>
          </p>
          <div class="text-text-default/60 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
            <span><strong class="text-heading">66M+</strong> B2B contacts</span>
            <span class="bg-border-light h-1 w-1 rounded-full" aria-hidden="true" />
            <span><strong class="text-heading">18</strong> data sources</span>
            <span class="bg-border-light h-1 w-1 rounded-full" aria-hidden="true" />
            <span><strong class="text-heading">10M+</strong> companies</span>
            <span class="bg-border-light h-1 w-1 rounded-full" aria-hidden="true" />
            <span>from <strong class="text-heading">$59/mo</strong></span>
          </div>
        </div>

        <Customers
          content={customers}
          data-aos-delay="600"
          data-aos-duration="900"
          data-aos="fade-in"
        />
      </div>
    </div>

    <!-- Banner Image -->
    {
      image && (
        <div
          data-aos="fade-up-sm"
          data-aos-offset="0"
          class="relative mx-4 mt-12 -mb-4 max-w-screen-xl md:m-0 md:mx-auto md:mt-20">
          <div class="bg-body relative z-10 overflow-hidden rounded-t-2xl px-0.5 pt-0.5 md:rounded-t-3xl">
            <div class="after:bg-primary/10 relative z-20 overflow-hidden rounded-t-2xl bg-black after:absolute after:inset-0 after:size-full after:rounded-t-2xl after:content-[''] md:rounded-t-3xl">
              {image.endsWith(".svg") ? (
                <img
                  class="rounded-t-2xl md:rounded-t-3xl w-full h-auto"
                  src={image}
                  alt={"About " + plainify(title).toLowerCase()}
                  width="1200"
                  height="720"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <OptimizedImage
                  class="rounded-t-2xl md:rounded-t-3xl w-full h-auto"
                  src={image}
                  width={1920}
                  widths={[768, 1280, 1920]}
                  sizes="(min-width: 1280px) 1280px, 100vw"
                  format="webp"
                  alt={imageAlt || "About " + plainify(title).toLowerCase()}
                  loading="eager"
                  fetchpriority="high"
                />
              )}
            </div>

            {/* Gradient Animated Background Image */}
            <div
              class="home-banner from-body to-primary absolute top-1/2 left-1/2 z-10 h-screen w-1/2 origin-[0%_15%] bg-linear-to-l"
              aria-hidden="true"
            />
          </div>
        </div>
      )
    }
  </div>

  {
    videoButton && (
      <VideoModal
        video={{
          id: videoButton.video?.id,
          src: videoButton.video?.src,
          provider: videoButton.video?.provider,
        }}
      />
    )
  }
</section>
