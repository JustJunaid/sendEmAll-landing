---
import SEO from "@/components/seo/Seo.astro";
import JsonLD from "../widgets/JsonLD.astro";
import Favicons from "@/components/seo/Favicons.astro";
import OpenGraph from "@/components/seo/OpenGraph.astro";
import config from ".astro/config.generated.json";
import fontsJson from "@/config/fonts.json";
import { Font } from "astro:assets";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
---

<head>
  <!------------
    General
-------------->
  <meta charset="UTF-8" />

  {/* Theme pre-paint — runs synchronously before first paint to prevent FOUC.
      Resolution: localStorage.theme wins → else system preference → else light. */}
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>

  {/* A/B pre-paint — kills the variant flash.

      The server renders the `control` variant visible (right for crawlers and
      for JS-off visitors). PostHog only answers which variant a person gets
      after its /flags round-trip — measured at ~670ms against a ~290ms first
      paint — so a non-control visitor watched the wrong headline for a beat
      before it swapped.

      PostHog caches the person's assignment in localStorage, so on every visit
      after the first we already know the answer synchronously. Emitting the
      swap as CSS here, before the body parses, means those visitors only ever
      see their own variant. A first-ever visitor still gets control until the
      network answers — unavoidable without server-side rendering, and control
      is the approved default headline.

      experiment.ts removes this style once real flags land, so the live answer
      always wins over the cached one. */}
  <script is:inline>
    (function () {
      try {
        var storeKey = null;
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && /^ph_.+_posthog$/.test(k)) {
            storeKey = k;
            break;
          }
        }
        if (!storeKey) return;
        var flags =
          (JSON.parse(localStorage.getItem(storeKey)) || {})
            .$enabled_feature_flags || {};
        var safe = /^[A-Za-z0-9_-]+$/;
        var css = "";
        for (var flag in flags) {
          var variant = flags[flag];
          if (typeof variant !== "string" || variant === "control") continue;
          if (!safe.test(flag) || !safe.test(variant)) continue;
          css +=
            '[data-ab="' + flag + '"]{display:none !important}' +
            '[data-ab="' + flag + '"][data-ab-variant="' + variant +
            '"]{display:block !important}';
        }
        if (!css) return;
        var style = document.createElement("style");
        style.id = "ab-preboot";
        style.textContent = css;
        document.head.appendChild(style);
      } catch (e) {}
    })();
  </script>

  {/* LCP fail-safe: mark JS active before first paint so AnimatedText can hide
      words for its entrance animation, and force-reveal them if motion never
      initializes (blocked script, slow network) — hero text is never stuck. */}
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add("js-loaded");
      window.setTimeout(function () {
        if (!window.__animatedTextReady) d.classList.remove("js-loaded");
      }, 2000);
    })();
  </script>

  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO {...Astro.props} />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content="#fff"
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />

  <!-- Preconnect to critical third-party origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://us.i.posthog.com" />
  <link rel="dns-prefetch" href="https://widget.intercom.io" />

  {/* Third-party scripts moved to before </body> in Base.astro for performance */}
  <OpenGraph {...Astro.props} />
  <Favicons />
  <JsonLD
    content={{
      ...Astro.props,
    }}
  />

  <!------------------
    Google Fonts
-------------------->
  {fontVariables.map((font) => <Font cssVariable={font} />)}
</head>
